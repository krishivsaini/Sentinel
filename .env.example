# Copy to .env and fill in. .env is gitignored — never commit real values.
# The embedding + reranker models run locally at ₹0; only the LLM calls need a key.

# --- OpenAI (paid) — optional, candidate Ragas judge + v2 guardrails classifier ---
# Key from https://platform.openai.com/api-keys. Requests use the half-price "flex" tier by
# default (SENTINEL_OPENAI_SERVICE_TIER). Not used unless a *_PROVIDER below is set to "openai".
OPENAI_API_KEY=

# --- DeepSeek (paid, OpenAI-compatible) — optional, for the Ragas judge ---
# Key from https://platform.deepseek.com/api_keys. Off-peak rates are half of peak.
# Without it everything still runs on Groq's free tier, just with rate-limit pacing.
DEEPSEEK_API_KEY=

# --- NVIDIA build.nvidia.com (OpenAI-compatible; free tier is per-model, 40 RPM each) ---
# Free key from https://build.nvidia.com — generation, judge, and the v2 guardrails classifier
# each get independent quota, unlike a single shared pool.
NVIDIA_API_KEY=

# --- Groq (alternate provider for generation + Ragas judge) ---
# Free key (no credit card) from https://console.groq.com/keys
# Chosen because Gemini's free tier caps at ~20 requests/day/model — far too few for the eval
# or the CI gate — whereas Groq's free tier gives llama-3.3-70b ~1,000 requests/day.
GROQ_API_KEY=

# --- Gemini (alternate LLM provider; only if you switch *_PROVIDER back to "google") ---
# Free-tier key from https://aistudio.google.com/apikey. Optional — leave blank when using Groq.
GOOGLE_API_KEY=

# --- JWT auth for the /query endpoint (single demo user — §11) ---
# Generate a strong random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SENTINEL_JWT_SECRET=

# --- Demo user credentials (the only account; not multi-tenant — out of scope §1.3) ---
SENTINEL_DEMO_USER=demo
SENTINEL_DEMO_PASSWORD=change-me

# --- Optional overrides (defaults live in sentinel/config.py) ---
# SENTINEL_GENERATION_PROVIDER=groq
# SENTINEL_GENERATION_MODEL=openai/gpt-oss-20b
# SENTINEL_JUDGE_PROVIDER=groq          # re-run scripts/judge_calibration.py before changing
# SENTINEL_JUDGE_MODEL=openai/gpt-oss-120b
# SENTINEL_OPENAI_REASONING_EFFORT=none
# SENTINEL_OPENAI_SERVICE_TIER=flex
# SENTINEL_FAITHFULNESS_THRESHOLD=0.80
